{
  "name": "@local/dsh-pikachu-pet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unofficial fan-made Pikachu desktop pet plugin for the DeepSeek Harness Web GUI.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE",
    "assets/*",
    "src/*",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node src/build-client.cjs",
    "verify": "node src/verify-client.cjs"
  }
}
